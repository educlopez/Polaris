---
interface Props {
  background: string;
  blur?: string;
  className?: string;
  debug?: boolean;
  height?: string;
  side?: "top" | "bottom" | "left" | "right";
  stop?: string;
  style?: Record<string, string | number>;
}

const {
  stop = "25%",
  blur = "4px",
  height = "48px",
  side = "top",
  className = "",
  background,
  debug = false,
  style = {},
  ...rest
} = Astro.props;

// CSS styles for the fade effect
const fadeStyles = {
  "--background": background,
  "--blur": blur,
  "--height": height,
  "--stop": stop,
  ...(debug && {
    outline: "2px solid var(--color-amber-500)",
  }),
  ...style,
};
---

<div
  aria-hidden="true"
  class={`fade-root ${className}`}
  data-side={side}
  style={fadeStyles}
  {...rest}
></div>

<style>
  .fade-root {
    --blur: 4px;
    --stop: 25%;
    --height: 48px;
    position: fixed;
    left: 0;
    width: 100%;
    height: var(--height);
    pointer-events: none;
    -webkit-user-select: none;
    user-select: none;
    backdrop-filter: blur(var(--blur));

    &[data-side="top"] {
      top: 0;
      background: linear-gradient(0deg, transparent, transparent);
      mask-image: linear-gradient(
        to bottom,
        var(--background) var(--stop),
        transparent
      );
    }

    &[data-side="left"] {
      left: 0;
      width: var(--height);
      height: 100%;
      background: linear-gradient(to left, transparent, var(--background));
      mask-image: linear-gradient(
        to right,
        var(--background) var(--stop),
        transparent
      );
    }

    &[data-side="right"] {
      right: 0;
      left: unset;
      width: var(--height);
      height: 100%;
      background: linear-gradient(to right, transparent, var(--background));
      mask-image: linear-gradient(
        to left,
        var(--color-primary) var(--stop),
        transparent
      );
    }

    &[data-side="bottom"] {
      bottom: 0;
      background: linear-gradient(to bottom, transparent, var(--background));
      mask-image: linear-gradient(
        to top,
        var(--color-primary) var(--stop),
        transparent
      );
    }
  }
</style>
